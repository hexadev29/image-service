{
  "name": "rank-profile-image-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "render:sample": "tsx src/scripts/render-rank-profile-sample.ts",
    "render:scale1:svg": "tsx src/scripts/render-scale1-svg.ts",
    "render:scale1:png": "tsx src/scripts/render-scale1-png.ts",
    "compare:scale1": "tsx src/scripts/compare-scale1.ts",
    "render:compare": "tsx src/scripts/render-comparison-samples.ts",
    "test:bandwidth": "npm run build && tsx src/scripts/test-scale1-svg-bandwidth.ts",
    "benchmark:rank-svg": "npm run build && tsx src/scripts/benchmark-rank-svg.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.78",
    "axios": "^1.18.1",
    "fastify": "^5.2.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
